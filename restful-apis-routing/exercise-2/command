const express = require("express");
const app = express();

app.use(express.json());

// Validation middleware
function validateYear(req, res, next) {
  const { year } = req.body;

  if (typeof year !== "number" || year < 1900 || year > new Date().getFullYear()) {
    return res.status(400).json({
      error: "Invalid year. Must be a number between 1900 and current year."
    });
  }

  next();
}

// Example route using middleware
app.post("/books", validateYear, (req, res) => {
  res.json({ message: "Book added successfully", book: req.body });
});

app.listen(3001, () => console.log("Exercise 2 running on port 3001"));
