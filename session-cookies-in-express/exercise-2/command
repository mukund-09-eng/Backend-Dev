const languageMiddleware = (req, res, next) => {
  const lang = req.cookies.language || "en";
  req.language = lang;
  next();
};

const setLanguage = (req, res) => {
  const { lang } = req.query;
  res.cookie('language', lang, { maxAge: 900000 });
  res.send("Language set");
};

module.exports = { languageMiddleware, setLanguage };
