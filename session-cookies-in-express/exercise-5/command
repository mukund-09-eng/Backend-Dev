const cartMiddleware = (req, res, next) => {
  // If logged in → use session
  if (req.session.user) {
    if (!req.session.cart) req.session.cart = [];
    req.cart = req.session.cart;
  } 
  // If not logged in → use cookies
  else {
    if (!req.cookies.cart) {
      res.cookie('cart', JSON.stringify([]));
      req.cart = [];
    } else {
      req.cart = JSON.parse(req.cookies.cart);
    }
  }

  next();
};

// Add item
const addToCart = (req, res) => {
  const item = req.body.item;

  req.cart.push(item);

  if (req.session.user) {
    req.session.cart = req.cart;
  } else {
    res.cookie('cart', JSON.stringify(req.cart));
  }

  res.send("Item added");
};

// Merge cart on login
const mergeCart = (req) => {
  if (req.cookies.cart) {
    const cookieCart = JSON.parse(req.cookies.cart);
    req.session.cart = [...(req.session.cart || []), ...cookieCart];
  }
};

module.exports = { cartMiddleware, addToCart, mergeCart };
